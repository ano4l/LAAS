{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laas-api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/python.mjs", "-m", "uvicorn", "apps.api.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "laas-web",
      "runtimeExecutable": "node",
