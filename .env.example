APP_ENV=production
APP_VERSION=0.1.0
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
STORAGE_ROOT=data/storage
MAX_UPLOAD_MB=4096
# Uploads always use real detection. Synthetic analysis is only on /demo-job.
# Set an absolute path on a server. Locally, existing reference weights are discovered.
YOLO_MODEL_PATH=
YOLO_DEVICE=cpu
ANALYSIS_PROFILE=accurate
# Moving-camera default. For genuinely fixed views, bytetrack is a lower-cost alternative.
TRACKER_BACKEND=botsort
# Switch to modal only after deployment and the GPU smoke test succeed.
ANALYSIS_COMPUTE=local
# With ANALYSIS_COMPUTE=modal: ANALYSIS_FALLBACK=local runs a failed cloud job on this machine with FALLBACK_PROFILE (default balanced)
# CPU: YOLO_CPU_THREADS defaults to the physical core count; ANNOTATED_FRAMES=analysed writes only analysed frames to the playback video
# Accurate defaults to every source frame and 1280px; preview uses 5fps / 640px.
# Optional overrides: ANALYSIS_FPS=5 and YOLO_IMAGE_SIZE=640
# Experimental cropped ball search: 640; leave 0 until benchmarked on reviewed footage.
BALL_TILE_SIZE=0
BALL_CONFIDENCE=0.1
OBJECT_CONFIDENCE=0.45
# Optional specialist ball detector; missing positions are never fabricated.
YOLO_BALL_MODEL_PATH=
# Optional secondary ball model, sampled at up to 2fps on weak primary detections.
YOLO_BALL_RESCUE_PATH=
# Optional pitch landmark model for the estimated pitch map; 'off' disables the packaged default.
YOLO_PITCH_MODEL_PATH=
OPENAI_API_KEY=
VITE_API_URL=
VITE_DEMO_MODE=false

# Expanded-box matching for small, fast players (0 disables). See docs/testing/TRACK_LINKING_2026-11-14.md
TRACK_IOU_EXPANSION=0.5
# Optional appearance embeddings for offline track linking: off or detector
TRACK_EMBEDDINGS=off
