# Candidate settings to benchmark, not a claim of validated accuracy.
STORAGE_ROOT=/workspace/storage
YOLO_MODEL_PATH=/workspace/models/football.pt
# Optionally provision a separately trained ball detector:
YOLO_BALL_MODEL_PATH=
YOLO_DEVICE=0
ANALYSIS_FPS=30
YOLO_IMAGE_SIZE=1280
BALL_CONFIDENCE=0.1
OBJECT_CONFIDENCE=0.15
MAX_UPLOAD_MB=4096
