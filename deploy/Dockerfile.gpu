# Build the web UI separately so the GPU runtime does not need Node.
FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY apps/web/package*.json ./apps/web/
RUN npm --prefix apps/web install
COPY apps/web ./apps/web
RUN npm --prefix apps/web run build

FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
# CUDA wheels include user-space CUDA libraries; the host supplies the NVIDIA driver.
RUN pip install --no-cache-dir torch==2.13.0 torchvision==0.28.0 \
    --index-url https://download.pytorch.org/whl/cu126
COPY pyproject.toml ./
COPY apps/api ./apps/api
COPY workers ./workers
COPY scripts ./scripts
RUN pip install --no-cache-dir '.[cv]'
COPY --from=frontend /build/apps/web/dist ./apps/web/dist
ENV STORAGE_ROOT=/workspace/storage YOLO_MODEL_PATH=/workspace/models/football.pt \
    YOLO_DEVICE=0 ANALYSIS_FPS=30 YOLO_IMAGE_SIZE=1280 \
    BALL_CONFIDENCE=0.1 OBJECT_CONFIDENCE=0.15
# Batch analysis avoids publishing an unauthenticated upload API.
ENTRYPOINT ["python", "scripts/analyze_video.py"]
CMD ["--help"]
