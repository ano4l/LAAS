{
  "name": "football-ai-analytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "python -m uvicorn apps.api.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm --prefix apps/web run dev -- --host 127.0.0.1 --port 5173",
    "build": "npm --prefix apps/web run build",
    "start:api": "python -m uvicorn apps.api.main:app --host 0.0.0.0 --port 8000",
    "railway:start": "python -m uvicorn apps.api.main:app --host 0.0.0.0 --port $PORT",
    "test": "python -m compileall apps workers"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
